# Grounded Studio - example environment. Copy to .env and fill in secrets.
# Synthetic placeholders only; never commit real credentials.

# ---- deployment profile -------------------------------------------------
# offline      : everything on private/local infrastructure (default)
# aws-private  : may use explicitly allowlisted Amazon Bedrock / Nova and
#                private S3 through VPC endpoints. See docs/18-deployment-profiles.md.
GROUNDED_DEPLOYMENT_MODE=offline
GROUNDED_ENV=production
# Extra internal DNS suffixes that count as private (comma list).
GROUNDED_INTERNAL_SUFFIXES=internal,local,corp,svc,cluster.local

# ---- private infrastructure ---------------------------------------------
POSTGRES_USER=grounded
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grounded
MINIO_ROOT_USER=grounded
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=grounded
MINIO_REGION=us-east-1

# ---- authentication (fail closed when unset) -----------------------------
# oidc | trusted-header   (dev is refused unless GROUNDED_ENV=development)
AUTH_MODE=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_FILE=
OIDC_JWKS_URL=
AUTH_PROXY_SECRET=
AUTH_USER_HEADER=X-Authenticated-User
BOOTSTRAP_ADMINS=
DEV_BYPASS_AUTH=false

# ---- providers (explicit; no automatic fallback) --------------------------
# none | local | bedrock (bedrock only in aws-private)
GROUNDED_INFERENCE_PROVIDER=none
# comma list of polish, chat, summary - empty means retrieval-only
GROUNDED_ASSIST_FEATURES=
# Internal OpenAI-compatible server (vLLM / Ollama) on private infrastructure.
MODEL_BASE_URL=
MODEL_NAME=local-instruct
# local-hash | local-onnx (needs GROUNDED_EMBEDDING_MODEL_DIR with model.onnx + tokenizer.json) | bedrock
GROUNDED_EMBEDDING_PROVIDER=local-hash
# GROUNDED_EMBEDDING_MODEL_DIR=/opt/embeddings/minilm
GROUNDED_TRANSCRIPTION_PROVIDER=local
GROUNDED_TTS_PROVIDER=local
# none | local-ocr | bedrock. Also reads on-screen text in recordings (SCREEN_INTERVAL_S).
GROUNDED_IMAGE_TEXT_PROVIDER=local-ocr
SCREEN_INTERVAL_S=2
# Narrated mp4 for decks (onboarding, training, launches): on | off
DECK_VIDEO=on

# Local weights are baked into the worker image; runtime downloads are off.
WHISPER_MODEL=base
WHISPER_CACHE=/opt/whisper
PIPER_BIN=/opt/piper/piper
PIPER_MODEL=/opt/piper/en_US-lessac-medium.onnx
HF_HUB_OFFLINE=1
TRANS_LANGUAGE=en-US

# ---- aws-private only (leave empty in offline mode) ----------------------
# GROUNDED_AWS_REGIONS=us-east-1
# GROUNDED_AWS_SERVICES=bedrock-runtime,s3
# GROUNDED_BEDROCK_MODELS=amazon.nova-pro-v1:0,amazon.nova-lite-v1:0,amazon.titan-embed-text-v2:0
# GROUNDED_BEDROCK_TEXT_MODEL=amazon.nova-pro-v1:0
# GROUNDED_BEDROCK_MULTIMODAL_MODEL=amazon.nova-lite-v1:0
# GROUNDED_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# GROUNDED_BEDROCK_ENDPOINT=https://vpce-0123456789abcdef0-xxxx.bedrock-runtime.us-east-1.vpce.amazonaws.com
# GROUNDED_AWS_ENDPOINTS=https://vpce-0123456789abcdef0-xxxx.bedrock-runtime.us-east-1.vpce.amazonaws.com
# GROUNDED_AWS_PRIVATE_DNS=false
# GROUNDED_OBJECT_BUCKETS=grounded-private-artifacts
# GROUNDED_OBJECT_KMS_KEY=arn:aws:kms:us-east-1:111122223333:key/00000000-0000-0000-0000-000000000000
