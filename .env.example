POSTGRES_USER=grounded
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grounded
DATABASE_URL=postgresql+psycopg://grounded:change-me@postgres:5432/grounded

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=grounded
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=grounded
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=grounded
MINIO_SECRET_KEY=change-me-too

# Hard private mode. Public endpoints and managed external runtimes are refused.
EGRESS_MODE=offline
GROUND_ALLOW_PUBLIC_EGRESS=false
GROUND_INTERNAL_SUFFIXES=.internal,.local,.corp

# Optional company-network model endpoint. Empty = retrieval-only.
MODEL_BASE_URL=
MODEL_NAME=local-instruct

# Pre-provision these model files inside the private runtime.
WHISPER_MODEL=base
WHISPER_CACHE=/opt/whisper
PIPER_BIN=/opt/piper/piper
PIPER_MODEL=/opt/piper/en_US-lessac-medium.onnx
HF_HUB_OFFLINE=1

# Fail closed until SSO/workspace auth is wired.
DEV_BYPASS_AUTH=false
DEV_USER_EMAIL=dev@internal

TRANS_PROVIDER=local
TRANS_LANGUAGE=en-US
NARRATION_PROVIDER=local
