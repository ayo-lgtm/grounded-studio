POSTGRES_USER=grounded
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grounded
DATABASE_URL=postgresql+psycopg://grounded:change-me@postgres:5432/grounded

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=grounded
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=grounded
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=grounded
MINIO_SECRET_KEY=change-me-too

# Optional internal-only model endpoint. Public hosts are rejected.
MODEL_BASE_URL=
MODEL_NAME=local-instruct
GROUND_INTERNAL_SUFFIXES=.internal,.local,.corp
GROUND_ALLOW_PUBLIC_EGRESS=false

# Sensitive-data deployments fail closed until SSO is wired.
DEV_BYPASS_AUTH=false
DEV_USER_EMAIL=dev@internal

# Recording transcription: local model path or development stub only.
TRANS_PROVIDER=stub
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
TRANS_LANGUAGE=en

# Narration: empty (off) or local Piper.
NARRATION_PROVIDER=
PIPER_BIN=piper
PIPER_MODEL_PATH=
