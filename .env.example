POSTGRES_USER=grounded
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grounded
DATABASE_URL=postgresql+psycopg://grounded:change-me@postgres:5432/grounded

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=grounded
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=grounded
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=grounded
MINIO_SECRET_KEY=change-me-too

# offline refuses public object stores and never calls a generative API.
# aws-in-region is an explicit legacy opt-in for object storage only.
EGRESS_MODE=offline

# Optional on-network OpenAI-compatible server (Ollama or vLLM).
# Empty means retrieval only. A public host is ignored.
MODEL_BASE_URL=
MODEL_NAME=local-instruct

WHISPER_MODEL=base
WHISPER_CACHE=/opt/whisper
PIPER_BIN=/opt/piper/piper
PIPER_MODEL=/opt/piper/en_US-lessac-medium.onnx

DEV_BYPASS_AUTH=true
DEV_USER_EMAIL=dev@internal

# Transcription: local faster-whisper. transcribe/stub/aws fail closed.
TRANS_PROVIDER=local
TRANS_LANGUAGE=en-US

# Narration: local Piper or Kokoro. polly/elevenlabs fail closed.
# Set off to skip voiceover.
NARRATION_PROVIDER=local
