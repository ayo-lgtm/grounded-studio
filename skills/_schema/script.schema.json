{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroundedScript",
  "type": "object",
  "required": ["skill_id", "skill_version", "language", "beats"],
  "properties": {
    "skill_id": { "type": "string" },
    "skill_version": { "type": "string" },
    "language": { "type": "string" },
    "title": { "type": "string" },
    "provenance": {
      "type": "object",
      "properties": {
        "skill_id": { "type": "string" },
        "skill_version": { "type": "string" },
        "skill_path": { "type": "string" },
        "crafts": { "type": "array", "items": { "type": "string" } },
        "craft_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ord", "kind", "text", "citations"],
        "properties": {
          "ord": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string" },
          "layout": {
            "enum": ["cover", "big-number", "versus-target", "movers", "source-range", "risk", "ask", "statement", "step"]
          },
          "text": { "type": "string", "minLength": 1 },
          "visual": { "type": "object" },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["recording", "workbook", "document"] },
                "t_start_ms": { "type": "integer" },
                "t_end_ms": { "type": "integer" },
                "sheet": { "type": "string" },
                "addr": { "type": "string" },
                "block_id": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
